# Production environment variables for server
# Replace the placeholder values with your real production secrets/URLs.
# Do NOT commit real secrets to source control. Use your cloud provider's secret manager.

# Server port
PORT=5002

# MongoDB connection string (replace with your Atlas or managed DB URI)
MONGODB_URI=

# URL of the deployed AI microservice (include protocol)
AI_SERVICE_URL=

# Production mode
NODE_ENV=production

# Strong JWT secret used to sign tokens (set a long random value)
JWT_SECRET=

# Comma-separated list of allowed origins for CORS (production frontend URLs)
# Example: https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=

# Request body size limits
JSON_BODY_LIMIT=10kb
URLENCODED_BODY_LIMIT=10kb

# Logging level (info, warn, error, debug)
LOG_LEVEL=info
PORT=5002
MONGODB_URI=mongodb+srv://tanisha:abcd@cluster0.tqfslxm.mongodb.net/
AI_SERVICE_URL=http://localhost:5001
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
CORS_ORIGIN=https://yourfrontend-domain.com
